{
  "id": null,
  "uid": "cloud-network-overview",
  "title": "Cloud Network Monitor",
  "description": "Real Mininet network and application measurements. Use probe age to distinguish current from recorded data.",
  "tags": [
    "mininet",
    "networks-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter reachability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "Scrape reachability only. Application health is shown separately.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"cloud-network-monitor\"}",
          "legendFormat": "Exporter",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Reachable",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Web availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "Fraction of successful HTTP requests in the latest cycle.",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_http_success_ratio{source=\"client\",target=\"web_srv\"}",
          "legendFormat": "Successful requests",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Baseline checks",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "All baseline probes passed. This is not yet a statistical anomaly detector.",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_measurement_cycle_success",
          "legendFormat": "Baseline",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Degraded",
                  "color": "red"
                },
                "1": {
                  "text": "Passing",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Oldest probe age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "Measurement freshness. Scrape success alone does not guarantee new measurements.",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - cloud_probe_timestamp_seconds)",
          "legendFormat": "Age",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Round-trip latency by path",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "Actual ping RTT. The configured link delays affect both directions.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_ping_latency_seconds * 1000",
          "legendFormat": "{{source}} \u2192 {{target}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Packet loss by path",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_packet_loss_ratio * 100",
          "legendFormat": "{{source}} \u2192 {{target}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Web response and connection time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_http_response_seconds * 1000",
          "legendFormat": "HTTP total",
          "range": true
        },
        {
          "refId": "B",
          "expr": "cloud_http_connect_seconds * 1000",
          "legendFormat": "TCP connect",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "TCP throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "iperf3 receiver throughput. These active tests load the measured path.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_throughput_bits_per_second / 1000000",
          "legendFormat": "{{source}} \u2192 {{target}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Probe availability timeline",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "Measured success/failure transitions, including failure and recovery. Missing data is left as a gap.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_probe_success",
          "legendFormat": "{{probe}} \u00b7 {{source}} \u2192 {{target}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Available",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.8
      }
    },
    {
      "id": 10,
      "title": "RTT variation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "Ping RTT standard deviation (mdev); not one-way jitter.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_ping_variation_seconds * 1000",
          "legendFormat": "{{source}} \u2192 {{target}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "TCP retransmissions per test",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_tcp_retransmissions",
          "legendFormat": "{{source}} \u2192 {{target}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Collection duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_collection_duration_seconds",
          "legendFormat": "Cycle duration",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Collection status",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "description": "Whether a complete measurement cycle was collected, including failed probes.",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_collection_success",
          "legendFormat": "Collector",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Collection error",
                  "color": "red"
                },
                "1": {
                  "text": "Completed",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Requested experiment condition",
      "type": "state-timeline",
      "description": "Ground truth stage chosen by the experiment runner. This is separate from measured health and anomaly detection.",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_experiment_condition",
          "legendFormat": "{{condition}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Inactive",
                  "color": "transparent"
                },
                "1": {
                  "text": "Active",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "title": "Measurement source",
      "type": "stat",
      "description": "Synthetic simulation and historical imports must not be presented as fresh live network traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "cloud-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloud_measurement_source == 1",
          "legendFormat": "{{mode}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name"
      }
    }
  ]
}
